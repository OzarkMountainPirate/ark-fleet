# ci/.env  —  copy to ci/.env and fill in. GITIGNORED. Never commit.
#
# 1) Create a GitHub OAuth App: https://github.com/settings/developers
#      Homepage URL:              https://<CI_HOST>
#      Authorization callback URL: https://<CI_HOST>/authorize
WOODPECKER_GITHUB_CLIENT=
WOODPECKER_GITHUB_SECRET=
#
# 2) Shared server<->agent secret:  openssl rand -hex 32
WOODPECKER_AGENT_SECRET=

# Deployment-specific values used by docker-compose.yml:
CI_HOST=ci.example.com
CI_ADMIN_USER=your-github-username
CERT_DOMAIN=example.com
