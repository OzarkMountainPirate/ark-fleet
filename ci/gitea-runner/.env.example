# Copy to .env and fill. GITIGNORED — never commit the filled copy.
#
# Your Gitea instance (the URL the runner can reach):
GITEA_INSTANCE_URL=https://gitea.example.com
#
# One-time registration token, from Gitea:
#   Site Administration -> Actions -> Runners -> Create new runner
#   (or per-repo: Settings -> Actions -> Runners)
GITEA_RUNNER_TOKEN=
#
GITEA_RUNNER_NAME=ci-runner
