# netboot deployment config — copy to .env and edit per host/network:
#   cp .env.example .env
# The live .env is GITIGNORED. Read by docker-compose (HTTP_PORT) and setup.sh
# (all values). Keep comments on their own lines; no "# ..." after a value.

# This host's LAN IP — serves the preseed and is baked into the boot menus.
HTTP_HOST=192.168.1.10

# Preseed HTTP port. Pick one nothing else on the host uses.
HTTP_PORT=8079

# proxyDHCP scope — your LAN network address (the .0).
LAN_SUBNET=192.168.1.0

# Debian release to netboot.
SUITE=trixie

# --- Rendered into the published preseed by setup.sh ---
# Admin user created by the installer (also your Ansible ansible_user).
ADMIN_USER=admin
# Full name for the user account (cosmetic).
ADMIN_FULLNAME=Admin
# DNS domain handed to the installer.
NET_DOMAIN=lan.example.com
# Timezone for installed hosts.
TIMEZONE=America/Chicago

# Comma-separated MACs of already-installed hosts. dnsmasq ignores their PXE
# requests, so their firmware falls through to the local disk (no reinstall
# loop). Remove a MAC and re-run setup.sh + restart dnsmasq to reprovision.
INSTALLED_MACS=
