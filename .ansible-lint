---
profile: basic
exclude_paths:
  - .github/
skip_list:
  # dpkg/steamcmd/gamectl have no equivalent modules
  - command-instead-of-module
  # gamectl install is guarded by stat + async, not changed_when
  - no-changed-when
  # backup_*/cluster_nfs_* are deliberately fleet-wide knobs set in
  # group_vars/all.yml; role defaults share those names to act as fallbacks
  - var-naming[no-role-prefix]
