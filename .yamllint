---
extends: default
rules:
  line-length: { max: 160, level: warning }
  colons: { max-spaces-after: -1 }       # allow aligned values
  commas: { max-spaces-after: -1 }       # allow aligned inline dicts
  truthy: { allowed-values: ["true", "false"], check-keys: false }
  comments: { min-spaces-from-content: 1 }
  document-start: disable
  braces: { max-spaces-inside: 1 }
