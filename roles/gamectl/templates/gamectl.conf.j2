#############################################################
## gamectl.conf — MANAGED BY ANSIBLE (ark-fleet). Do not edit by hand.
## Host: {{ inventory_hostname }}
#############################################################

## ---- Paths & identity ---------------------------------------------------
ARK_ROOT="{{ ark_root }}"
ARK_USER="{{ ark_user }}"
STEAMCMD="/usr/games/steamcmd"
STEAM_HOME="/home/{{ ark_user }}"

## ---- Steam app IDs (do not change for ASE) ------------------------------
ARK_APPID="{{ ark_appid }}"
ARK_WORKSHOP_APPID="346110"

## ---- Steam branch (empty = live). Clients must match the branch's major
## version or these servers are hidden from their browser. -----------------
ARK_BRANCH="{{ ark_branch }}"

## Extra ?Key=Value launch options (rate multipliers; managed by ark-fleet's
## rate engine -- master dial ark_rate_multiplier + ark_rates overrides).
ARK_EXTRA_QUERY="{% for k, v in gamectl_rates.items() | sort if v.file == 'query' %}?{{ k }}={{ v.value }}{% endfor %}"

## ---- Cluster & admin ----------------------------------------------------
CLUSTER_ID="{{ cluster_id }}"
ADMIN_PASSWORD="{{ admin_password }}"

## ---- Mods ---------------------------------------------------------------
MODS="{{ mods | join(',') }}"
## Engine-side mod management stays OFF (SEGV on modern Linux); gamectl
## pre-installs the MODS list instead.
ARK_AUTOMANAGED_MODS="false"

## ---- Instances (this host only; derived from ark_maps + ark_port_map) ----
## Format: [key]="MapName GamePort QueryPort RconPort"
declare -A INSTANCES=(
{% for m in ark_maps %}
  [{{ m | lower }}]="{{ m }} {{ ark_port_map[m].game }} {{ ark_port_map[m].query }} {{ ark_port_map[m].rcon }}"
{% endfor %}
)

## ---- Backups ------------------------------------------------------------
BACKUP_KEEP_DAYS="{{ backup_keep_days }}"
