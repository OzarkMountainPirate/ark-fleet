[Unit]
Description=ARK save-safe backup (gamectl backup) + off-box push
After=network-online.target

[Service]
Type=oneshot
# gamectl backup stops each instance around the archive (live copies corrupt
# ARK saves), writes to {{ ark_root }}/bak, and prunes > BACKUP_KEEP_DAYS.
{% for m in ark_maps %}
ExecStart=/usr/local/bin/gamectl backup {{ m | lower }}
{% endfor %}
{% if backup_push_enabled | bool %}
# Push archives to the NAS via the NFS mount. NOT -a: the export squashes all
# access to one identity, so -a's owner/group preservation EPERMs and rsync
# exits 23 even though every byte copied. -rlpt = recurse/links/perms/times.
ExecStart=/usr/bin/rsync -rlpt --delete {{ ark_root }}/bak/ {{ backup_nfs_mount }}/{{ inventory_hostname }}/
{% endif %}
